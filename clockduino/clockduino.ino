// 21.4MHzduino: SFCから摘出した水晶(AD21L4/21.477MHz)で動く独立クロック源。
//
// ■ 役割
//   1. マスタークロック 21.477MHz -> カート1番   ... PB0(DIP14) から CKOUT で出力
//   2. CICクロック                -> カート56番  ... OC1A(D9) から Timer1 で出力
//   3. パイロットランプ                          ... D13
//
// ■ なぜこのボードがCICクロックを出すのか
// sanniはCICクロック(3.072MHz)をカート56番へ**流しっぱなし**にしている。
// このリグでそれを再現しようとしてNano-3のloop()からソフトウェアでトグルしたら、
// **全バンクが0x01や0x03の一色になって読み出しが完全に壊れた**（2回失敗）。
// 原因はNano-3がバンク生成(A16-A23)とストローブ受信を兼任していること。
// cli()を挟んでピンを叩くと、バンクストローブを取りこぼしバスに干渉する。
//
// Nano-3のハードウェアタイマー出力OC1AはD9=バンク線A23で埋まっていて使えない。
// そこで「ピンが足りない」と結論したが、**それはNano-3だけを見ていた誤り**だった。
// このボードはPB0とD13しか使っておらず、20本以上のピンとタイマー3本が空いている。
// しかもバンク生成にもストローブにも関与しないので、**割り込み競合が原理的に起きない。**
//
// ■ 周波数について
// システムクロックが21.477MHzなので、Timer1のCTC+トグルで作れるのは
//   OCR1A=1: 5.3693MHz / =2: 3.5795MHz / =3: 2.6847MHz / =4: 2.1477MHz
// **3.072MHzちょうどは整数分周で作れない**（最良でも誤差12.6%）。
// 実機でもCICは独立発振なので、21.477MHzとは整数比にならないのが道理。
//
// ただしNOTES.mdに「Keyはパルスを数えて動く（間引きを変えても同じパルス数で反応）」
// という実測がある。周波数の絶対値より供給されていること自体が効く可能性があるので、
// まず一番近い 2.6847MHz (OCR1A=3) で試す。
// CIC_OCR1A を変えれば掃引できる。

#include <Arduino.h>

// カート56番(CICクロック)へ出す分周値。21.477MHz/(2*(1+n))。
//   1 = 5.37MHz / 2 = 3.58MHz / 3 = 2.68MHz(既定、3.072MHzに最も近い) / 4 = 2.15MHz
// 0 にするとCICクロックを出さない（従来動作に戻す）。
const uint8_t CIC_OCR1A = 3;

void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);   // 通電の目印

  // マスタークロック(PB0/DIP14)は lfuse=0xBF の CKOUT がハードウェアで出している。
  // プログラムからは何もしない。

  if (CIC_OCR1A > 0) {
    // Timer1 CTCモード、比較一致でOC1A(D9)をトグル。分周なし。
    pinMode(9, OUTPUT);
    TCCR1A = _BV(COM1A0);              // OC1Aトグル
    TCCR1B = _BV(WGM12) | _BV(CS10);   // CTC(OCR1A), 分周なし
    OCR1A = CIC_OCR1A;
  }
}

void loop() {
  // 何もしない。クロックはどちらもハードウェアが出し続ける。
  // ここでピンを叩かないことが重要（それをやってNano-3側で2回壊した）。
}
